# ==========================================
# Smart System - Comprehensive .gitignore
# ==========================================

# Virtual Environments
.venv/
.venv-1/
venv/
env/
ENV/
env.bak/
venv.bak/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# PyInstaller / Distribution / Build
build/
dist/
*.spec
table_builder/dist/
table_builder/build/
table_builder/*.spec

# Environments & Sensitive Credentials
.env
.env.*
!.env.example

# Databases
*.sqlite3
*.sqlite3-journal
*.db

# Media & Temporary Data Files
media/*
!media/.gitkeep
table_builder/media/*
!table_builder/media/.gitkeep
*.xlsx
*.xls
*.csv
uploaded_file.*
ورقة عمل Microsoft Excel جديد.xlsx

# Static collected files (production bundle)
staticfiles/
table_builder/staticfiles/

# Logs
*.log

# Editor & OS files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
